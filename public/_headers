# Cloudflare Pages response headers. Vite copies public/ verbatim into dist/,
# so this file lands at dist/_headers, which is where Pages reads it.
#
# Pages applies every matching rule cumulatively, so two blocks both setting
# Cache-Control would be ambiguous. This block therefore carries security
# headers ONLY: index.html and the unhashed files copied from public/
# (/models/*, /branding/*, /cv/*, /icons/*, /robots.txt) keep the platform
# default, which revalidates — they have stable filenames across deploys, so
# caching them immutably would strand visitors on old models and a stale CV.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# Vite content-hashes everything it emits here, so the filename changes
# whenever the bytes do and caching forever costs nothing.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

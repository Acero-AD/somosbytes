# Cloudflare Pages response headers. Vite copies public/ verbatim into dist/,
# so this file lands at dist/_headers, which is where Pages reads it.
#
# Pages applies every matching rule cumulatively, so two blocks both setting
# Cache-Control would be ambiguous. This block therefore carries security
# headers ONLY: index.html and the unhashed files copied from public/
# (/models/*, /branding/*, /cv/*, /icons/*, /robots.txt, /sitemap.xml, /404.html) keep
# platform default, which revalidates — they have stable filenames across deploys, so
# caching them immutably would strand visitors on old models and a stale CV.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# Vite content-hashes everything it emits here, so the filename changes
# whenever the bytes do and caching forever costs nothing.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Scene assets: stable filenames, but only ever replaced by a deliberate rerun of
# scripts/prepare-room-assets.mjs. Platform default (revalidate every request) costs a
# round trip of 304s before the room can draw. A day of freshness plus a week of
# stale-while-revalidate serves repeat visits from cache with no blocking request and
# still picks up a swapped asset on the next visit after it expires. Browsers without
# stale-while-revalidate (Safari) fall back to the max-age and still skip the 304s.
# Deliberately excludes /cv/*, /branding/* and /icons/*, which keep the revalidating
# default so a replaced CV is never stale.

/models/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/textures/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/environments/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
